APP_NAME="365HOME"
APP_VERSION=1.0.0
APP_ENV=
APP_KEY=
APP_DEBUG=1
APP_URL=
APP_LOCALE=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Theo dõi lỗi (Sentry, có gói miễn phí) — lấy DSN tại sentry.io > tạo project Laravel > Settings >
# Client Keys (DSN). Để trống thì không gửi gì cả, chỉ ghi log như trước (không lỗi nếu bỏ trống).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Chỉ cần khai báo nếu mysqldump KHÔNG có sẵn trong PATH hệ thống (vd Windows/XAMPP/Ampps) —
# dùng cho backup:run (spatie/laravel-backup). Production Linux thường để trống.
MYSQLDUMP_BINARY_PATH=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Zalo ZNS OTP
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_OTP_TEMPLATE_ID=

# Lấy tại SePay dashboard > Cấu hình > API/Webhook — dùng để xác thực webhook "biến động số dư"
# gọi về /webhook/sepay (xem App\Http\Controllers\Api\SePayWebhookController). Để trống thì
# webhook LUÔN bị từ chối (an toàn hơn cho qua mặc định).
SEPAY_API_KEY=
